# Run npx convex dev to create .env.local with your own deployment values.
# Replace these placeholders before starting the frontend.
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY

# Set on the Convex deployment, using the Clerk JWT template named convex:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Optional AI and notification secrets — Convex environment only:
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_FROM=
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_ASSISTANT_ID=
